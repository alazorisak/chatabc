<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Archive Submission Form</title>
</head>
<body>
    <h2>Submit to Earn Tokens</h2>
    <form id="submissionForm">
        <label for="username">Your Name/Handle:</label><br>
        <input type="text" id="username" name="username" required><br><br>

        <label for="content">Archive Content:</label><br>
        <textarea id="content" name="content" rows="6" required></textarea><br><br>

        <button type="submit">Submit Entry</button>
    </form>

    <p id="status"></p>

    <script>
        document.getElementById('submissionForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const statusText = document.getElementById('status');
            statusText.innerText = "Submitting...";

            // Configuration variables
            const OWNER = 'alazorisak'; 
            const REPO = 'chatabc';
            // Replace with your real token generated in Step 1
            const TOKEN = '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'; 

            const username = document.getElementById('username').value;
            const content = document.getElementById('content').value;

            try {
                const response = await fetch(`https://github.com{OWNER}/${REPO}/dispatches`, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/vnd.github+json',
                        'Authorization': `Bearer ${TOKEN}`
                    },
                    body: JSON.stringify({
                        event_type: 'user_submission',
                        client_payload: {
                            user: username,
                            text: content
                        }
                    })
                });

                if (response.ok) {
                    statusText.innerText = "Success! Your entry has been queued for the archive.";
                    document.getElementById('submissionForm').reset();
                } else {
                    statusText.innerText = "Error submitting to archive.";
                }
            } catch (err) {
                statusText.innerText = "Network error occurred.";
            }
        });
    </script>
</body>
</html>
